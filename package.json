{
  "name": "dsh-skins",
  "description": "Modular multi-skin pack for the DSH Web GUI; ships independent OpenBMC Harness and dummy UEFI Harness skins",
  "version": "0.3.1",
  "homepage": "https://github.com/iasiv5/skins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/skins.git"
  },
  "bugs": {
    "url": "https://github.com/iasiv5/skins/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skin",
    "theme",
    "openbmc",
    "uefi"
  ],
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.1-rc.2"
  },
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "watch": "node scripts/build-client.mjs --watch",
    "test": "node smoke-test.cjs",
    "check": "pnpm run build && node --check lib/client.js && node smoke-test.cjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
